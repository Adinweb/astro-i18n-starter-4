{
  "name": "astro-i18n-starter",
  "type": "module",
  "version": "1.0.0",
  "description": "Production-grade, multi-lingual (RTL + LTR), SSG-first Astro website starter.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "dev": "pnpm messages:compile && astro dev --port 4321",
    "messages:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm messages:compile && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "smoke": "node scripts/smoke.mjs",
    "clean": "rm -rf dist .astro src/paraglide",
    "block:adapt": "node scripts/block-adapt.mjs",
    "i18n:extract": "node scripts/i18n-extract.mjs",
    "i18n:add": "node scripts/i18n-add.mjs",
    "new:page": "node scripts/new-page.mjs",
    "new:post": "node scripts/new-post.mjs",
    "audit:i18n": "node scripts/audit-i18n.mjs",
    "knip": "knip"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.26.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.7",
    "magic-string": "^1.4.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "knip": "^6.40.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
